<%- include('partials/header', { title: 'Delete employee' }) %>

<h1>Delete employee</h1>
<p>Are you sure you want to delete this employee?</p>

<table class="details">
  <tr><th>ID</th><td><%= employee.id %></td></tr>
  <tr><th>Username</th><td><%= employee.username %></td></tr>
  <tr><th>Age</th><td><%= employee.age %></td></tr>
  <tr><th>Skills</th><td><%= employee.skills %></td></tr>
  <tr><th>Title</th><td><%= employee.title %></td></tr>
</table>

<form method="POST" action="/employees/<%= employee.id %>/delete" class="actions">
  <button type="submit" class="btn btn-danger">Yes, delete</button>
  <a href="/" class="btn btn-secondary">Cancel</a>
</form>

<%- include('partials/footer') %>
